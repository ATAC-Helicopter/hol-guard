{
  "schemaVersion": "guard.extension-contribution.v1",
  "id": "command.uivoid",
  "version": "1.0.0",
  "name": "uivoid",
  "description": "Reviews uivoid commands that create or reconfigure a live MCP server, rotate its outbound credential, or write local session and skill files.",
  "trustClass": "external",
  "activation": "opt-in",
  "publisher": {
    "id": "community.uivoid",
    "displayName": "Community",
    "url": "https://github.com/corrideluca"
  },
  "icon": { "kind": "react-icon", "name": "HiMiniCloud", "background": "#0EA5E9" },
  "homepage": "https://www.uivoid.app",
  "license": "MIT",
  "executables": ["uivoid"],
  "ecosystemIds": ["uivoid"],
  "riskClasses": ["destructive_shell", "network_egress"],
  "actionClasses": [
    "uivoid live project creation command",
    "uivoid outbound credential rotation command",
    "uivoid oauth passthrough configuration command",
    "uivoid session credential write command",
    "uivoid agent skill install command"
  ],
  "referenceUrls": [
    "https://github.com/corrideluca/uivoid-cli",
    "https://portal.uivoid.app/docs"
  ],
  "saferAlternatives": [
    "Run uivoid whoami first to confirm which account and organization a command would target.",
    "Review the manifest of what uivoid create maps before approving a non-interactive run."
  ],
  "detector": {
    "kind": "python-module",
    "module": "codex_plugin_scanner.guard.runtime.command_uivoid_extensions"
  }
}
